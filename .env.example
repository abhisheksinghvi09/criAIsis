# criAIsis platform configuration.
#
# criAIsis is bring-your-own-key: model and embedding credentials belong to each
# CUSTOMER, are supplied through the management API, and are stored encrypted
# against their workspace. There is deliberately no platform-wide model key here,
# so no tenant can spend on, rate-limit, or leak through a shared credential.
#
# Copy to .env and fill in, then: set -a; source .env; set +a

CRIAISIS_PRIMARY_ENV=local
# 8080 is routinely taken by another service or a container port-forward, and a
# forward bound to 127.0.0.1 shadows this process on IPv4 without either failing.
CRIAISIS_SERVER_PORT=8088
CRIAISIS_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database (task db:up starts one matching these defaults) ---
# The dev container publishes 55432 on the host, so it cannot collide with a
# native PostgreSQL, another project, or an SSH tunnel on 5432.
CRIAISIS_DATABASE_HOST=localhost
CRIAISIS_DATABASE_PORT=55432
CRIAISIS_DATABASE_USER=postgres
CRIAISIS_DATABASE_PASSWORD=postgres
CRIAISIS_DATABASE_NAME=criaisis

# --- Platform secrets ---
# Encrypts every tenant credential at rest. EXACTLY 32 characters.
# Generate with: openssl rand -hex 16
# Rotating this makes all previously stored tenant credentials unreadable.
CRIAISIS_SECURITY_CREDENTIAL_ENCRYPTION_KEY=change-me-to-32-characters-now!!

# Bootstrap credential. Its only power is creating workspaces; it cannot read or
# change any tenant's keys. Generate with: openssl rand -base64 32
CRIAISIS_SECURITY_ADMIN_API_KEY=change-me-to-a-long-random-string

# --- Model defaults offered to new tenants (never keys) ---
CRIAISIS_LLM_SPECIALIST_MODEL=claude-opus-5
CRIAISIS_LLM_SYNTHESIS_MODEL=claude-opus-5
CRIAISIS_LLM_EMBEDDING_MODEL=text-embedding-3-small
CRIAISIS_LLM_EMBEDDING_BASE_URL=https://api.openai.com/v1
